{
  "name": "space-system-bot-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && nbb --classpath src -e \"(require 'bot-builder.main)\"",
    "dev": "nbb --classpath src -m bot-builder.main",
    "start": "nbb --classpath src -m bot-builder.main",
    "test": "nbb --classpath src:test -m bot-builder.test-runner"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "nbb": "^1.4.207"
  }
}
