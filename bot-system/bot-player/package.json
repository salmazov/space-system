{
  "name": "space-system-bot-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && nbb --classpath src:../game-rules-cljs/src -e \"(require 'bot-player.main)\"",
    "dev": "nbb --classpath src:../game-rules-cljs/src -m bot-player.main",
    "dev:bot": "npm run dev",
    "start": "nbb --classpath src:../game-rules-cljs/src -m bot-player.main",
    "test": "nbb --classpath src:test:../game-rules-cljs/src -m bot-player.test-runner"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "nbb": "^1.4.207"
  },
  "dependencies": {
    "space-system-game-rules": "0.1.0"
  }
}